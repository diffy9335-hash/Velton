# Get from Telegram @BotFather. NEVER put it in frontend code or public repos.
BOT_TOKEN=
# Public HTTPS URL for the Mini App, e.g. Cloudflare Tunnel or your domain.
APP_URL=https://your-domain.example/
# Only for LOCAL development. Never enable on a public deployment.
DEMO_MODE=0
DB_PATH=./data/velton.sqlite3

# Football clubs/players are read exclusively from world_data/packs/*.json.
# No external football API, API key, or fixed IP is required.
